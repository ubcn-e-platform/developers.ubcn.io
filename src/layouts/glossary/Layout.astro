---
import Footer from '../../components/Footer.astro';
import type {MarkdownLayoutProps} from "astro";

interface Frontmatter {
	title: string;
	description?: string;
	releasedAt?: string;
	writtenAt?: string;
}

type Props = MarkdownLayoutProps<Frontmatter>;

const {frontmatter} = Astro.props;
const {title, description, releasedAt, writtenAt} = frontmatter;

const classList = frontmatter.title === "유비씨엔 용어사전" ? `hidden` : 'grid gap-2';
---

<div class="px-4">
    <div>
        <div class={classList}>
            <a href={"/glossary/"}>＜용어사전으로 돌아가기</a>
        </div>
        <div class="bg-primary-2 h-48 rounded mb-4">
            <div class="text-gray-2 text-6xl font-bold text-center h-full contents-center">{frontmatter.title}</div>
        </div>
    </div>

    <div
        class="prose prose-sm max-w-none prose-headings:font-semibold prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-code:rounded prose-code:bg-gray-100 prose-code:px-1 prose-code:py-0.5 prose-code:text-gray-800 prose-pre:bg-gray-900 prose-blockquote:border-gray-200 prose-blockquote:bg-gray-50"
        id="contents"
    >
        <slot/>
    </div>

    <div class="doc-meta text-right">
        <span> · </span>
        <span>Created by <strong>김태우</strong></span>
    </div>
    <hr>
    <Footer/>
</div>
<script>
  import mediumZoom from "medium-zoom";

  let zoom: any;

  const initZoom = () => {
    const targets = document.querySelectorAll("#contents img[data-zoomable]");
    if (!targets.length) return;

    zoom?.detach();

    zoom = mediumZoom(targets, {
      margin: 24,
      background: "rgba(0,0,0,0.9)",
      scrollOffset: 40
    });
  };

  initZoom();
  document.addEventListener("astro:page-load", initZoom);
</script>
