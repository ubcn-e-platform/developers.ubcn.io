---
import Footer from '../../components/Footer.astro';
import "../../assets/styles/style.css";

const {frontmatter} = Astro.props;
const classList = frontmatter.title === "서비스 운영 정책" ? `hidden` : 'grid gap-2';
---

<div class="px-4">
    <div>
        <div class={classList}>
            <a href={"/policy/"}>＜서비스 운영 정책으로 돌아가기</a>
        </div>
        <div class="bg-primary-2 h-48 rounded mb-4">
            <div class="text-gray-2 text-6xl font-bold text-center h-full contents-center">{frontmatter.title}</div>
        </div>
    </div>

    <div class="mb-20" id="contents">
        <slot/>
    </div>
    <hr>
    <Footer/>
</div>
